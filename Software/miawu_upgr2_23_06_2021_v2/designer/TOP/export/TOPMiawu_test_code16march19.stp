PROCEDURE DO_READ_CERTIFICATE USES GV,READ_SHARED_BUFFER;
    PASS = 0;
    BOOLEAN READ_CERT_RESULT[8];
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $a2;
    WAIT IDLE, 1 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 8, $00, CAPTURE READ_CERT_RESULT[7..0];
        IF ( ! (READ_CERT_RESULT[7]==0) ) THEN GOTO READ_CERT_POLL;
        IPOLL = 0;
        PASS = 1;
        READ_CERT_POLL:
        IF ( ! (PASS==0) ) THEN GOTO READ_CERT_DONE;
        IRSCAN 8, $a2;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        READ_CERT_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (READ_CERT_RESULT[0]==1) ) THEN GOTO READ_CERT_INVALID;
    IBLOCKS = 48;
    CALL READ_SHARED_BUFFER;
    IF ( ! (DUMPDEVCERTINFO==1) ) THEN GOTO DONTDISPLAY;
    IF ( ! (SHARED_BUFFER[4472]==1) ) THEN GOTO NOTSF2PART;
    PRINT "Family: SmartFusion2";
    NOTSF2PART:
    IF ( ! (SHARED_BUFFER[4472]==0) ) THEN GOTO NOTIGLOO2PART;
    PRINT "Family: Igloo2";
    NOTIGLOO2PART:
    PRINT "Product: ",CHR$(INT(SHARED_BUFFER[1567..1560])),CHR$(INT(SHARED_BUFFER[1575..1568]))
        ,CHR$(INT(SHARED_BUFFER[1583..1576])),CHR$(INT(SHARED_BUFFER[1591..1584]))
        ,CHR$(INT(SHARED_BUFFER[1599..1592])),CHR$(INT(SHARED_BUFFER[1607..1600]))
        ,CHR$(INT(SHARED_BUFFER[1615..1608])),CHR$(INT(SHARED_BUFFER[1623..1616]))
        ,CHR$(INT(SHARED_BUFFER[1631..1624])),CHR$(INT(SHARED_BUFFER[1639..1632]))
        ,CHR$(INT(SHARED_BUFFER[1647..1640])),CHR$(INT(SHARED_BUFFER[1655..1648]))
        ,CHR$(INT(SHARED_BUFFER[1663..1656])),CHR$(INT(SHARED_BUFFER[1671..1664]))
        ,CHR$(INT(SHARED_BUFFER[1679..1672])),CHR$(INT(SHARED_BUFFER[1687..1680]))
        ,CHR$(INT(SHARED_BUFFER[1695..1688])),CHR$(INT(SHARED_BUFFER[1703..1696]))
        ,CHR$(INT(SHARED_BUFFER[1711..1704])),CHR$(INT(SHARED_BUFFER[1719..1712]))
        ,CHR$(INT(SHARED_BUFFER[1727..1720])),CHR$(INT(SHARED_BUFFER[1735..1728]))
        ,CHR$(INT(SHARED_BUFFER[1743..1736])),CHR$(INT(SHARED_BUFFER[1751..1744]))
        ,CHR$(INT(SHARED_BUFFER[1759..1752])),CHR$(INT(SHARED_BUFFER[1767..1760]))
        ,CHR$(INT(SHARED_BUFFER[1775..1768])),CHR$(INT(SHARED_BUFFER[1783..1776]))
        ,CHR$(INT(SHARED_BUFFER[1791..1784])),CHR$(INT(SHARED_BUFFER[1799..1792]))
        ,CHR$(INT(SHARED_BUFFER[1807..1800])),CHR$(INT(SHARED_BUFFER[1815..1808]))
        ,CHR$(INT(SHARED_BUFFER[1823..1816]));
    BUFF32[15..0] = $ffff;
    IF ( ! (INT(SHARED_BUFFER[4327..4312])!=INT(BUFF32[15..0])) ) THEN GOTO DONT_DISPLAY_GRADE;
    EXPORT "Grade", SHARED_BUFFER[4343..4216];
    DONT_DISPLAY_GRADE:
    LABEL_SEPARATOR = 0;
    DONTDISPLAY:
    LABEL_SEPARATOR = 0;
    READ_CERT_INVALID:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_SET_COFC_SIZE USES GV;
    COFC_FORMAT = 1;
    IF ( ! (INT(ID[27..0])==INT(M2S050[31..0])) ) THEN GOTO NOT_050;
    IF ( ! (IDREV<4) ) THEN GOTO NEW_050;
    COFC_FORMAT = 0;
    NEW_050:
    LABEL_SEPARATOR = 0;
    NOT_050:
    IF ( ! ( ( ( ( (INT(ID[27..0])==INT(M2S010[31..0]))||(INT(ID[27..0])==INT(M2S025[31..0])))||(INT(ID[27..0])==INT(M2S005[31..0])))||(INT(ID[27..0])==INT(M2S150[31..0])))||(INT(ID[27..0])==INT(M2S090[31..0]))) ) THEN GOTO NOT_OLD_COFC_DEVICE;
    IF ( ! (IDREV<1) ) THEN GOTO NEW_REV;
    COFC_FORMAT = 0;
    NEW_REV:
    LABEL_SEPARATOR = 0;
    NOT_OLD_COFC_DEVICE:
    IF ( ! (COFC_FORMAT==1) ) THEN GOTO OLD_COFC1;
    CERTIFICATE_SIZE = 912;
    OLD_COFC1:
    IF ( ! (COFC_FORMAT==0) ) THEN GOTO NEW_COFC;
    CERTIFICATE_SIZE = 656;
    NEW_COFC:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE PROC_ENABLE USES GV,DO_EXIT,SET_PGM_MODE,POLL_DEVICE_READY,DO_READ_SECURITY
    ,DO_READ_CERTIFICATE,DO_SET_COFC_SIZE;
    CALL POLL_DEVICE_READY;
    CALL DO_READ_CERTIFICATE;
    CALL DO_SET_COFC_SIZE;
    CALL SET_PGM_MODE;
    CALL DO_READ_SECURITY;
    BOOLEAN ISC_ENABLE_RESULT[32];
    BPGMMODE = 1;
    PASS = 0;
    BSR[665..0] = BSRPATTERN[665..0];
    BOOLEAN SHIFT_DATA[666];
    IRSCAN 8, $01;
    DRSCAN 666, BSR[];
    WAIT IDLE, 1 CYCLES;
    DRSCAN 666, SHIFT_DATA[], CAPTURE SAMPLE_DEVICE[];
    FOR I = 0 TO 665;
        IF ( ! (SAMPLEMASK[I]==1) ) THEN GOTO NOT_SAMPLE_MASK;
        BSR[I] = SAMPLE_DEVICE[I];
        NOT_SAMPLE_MASK:
        LABEL_SEPARATOR = 0;
    NEXT I;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $01;
    DRSCAN 666, BSR[];
    WAIT IDLE, 1 CYCLES;
    BOOLEAN TOOLINFO[32];
    TOOLINFO[5..0] = ACT_UROW_ALGO_VERSION[5..0];
    TOOLINFO[9..6] = ACT_UROW_PROGRAM_SW[3..0];
    TOOLINFO[22..17] = ACT_UROW_SW_VERSION[5..0];
    TOOLINFO[25..23] = ACT_UROW_PGM_SW[2..0];
    TOOLINFO[28..26] = BOOL(3);
    TOOLINFO[31..29] = BOOL(2);
    PASS = 0;
    BOOLEAN DPC_RESULT[64];
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $da;
    DRSCAN 64, $0000000004024040;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 64, $0000000000000000, CAPTURE DPC_RESULT[];
        IF ( ! (DPC_RESULT[63]==0) ) THEN GOTO DPC1_POLL;
        IPOLL = 0;
        PASS = 1;
        DPC1_POLL:
        IF ( ! (PASS==0) ) THEN GOTO DPC1_DONE;
        IRSCAN 8, $da;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        DPC1_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $80;
    DRSCAN 32, TOOLINFO[];
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 32, $00000000, CAPTURE ISC_ENABLE_RESULT[31..0];
        IF ( ! (INT(ISC_ENABLE_RESULT[23..0])==INT(TOOLINFO[23..0])) ) THEN GOTO JTAG_NOT_LOCKED;
        PRINT "JTAG interface is protected by UPK1";
        STATUS = -30;
        UNIQUEEXITCODE = 32815;
        BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
        EXPORT "ERROR_CODE", BUFF32[15..0];
        CALL DO_EXIT;
        JTAG_NOT_LOCKED:
        IF ( ! (ISC_ENABLE_RESULT[31]==0) ) THEN GOTO ISC_ENABLE_POLL;
        IPOLL = 0;
        PASS = 1;
        ISC_ENABLE_POLL:
        IF ( ! (PASS==0) ) THEN GOTO ISC_ENABLE_DONE;
        IRSCAN 8, $80;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        ISC_ENABLE_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    EXPORT "ISC_ENABLE_RESULT", ISC_ENABLE_RESULT[];
    EXPORT "CRCERR", ISC_ENABLE_RESULT[0..0];
    EXPORT "EDCERR", ISC_ENABLE_RESULT[1..1];
    IF ( ! ( ( (PASS==0)||( (PASS==1)&&(ISC_ENABLE_RESULT[0]==1)))||( (PASS==1)&&(INT(ISC_ENABLE_RESULT[31..0])==0))) ) THEN GOTO ISC_ENABLE_PASS;
    PRINT "Failed to enter programming mode.";
    STATUS = 5;
    UNIQUEEXITCODE = 32771;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    ISC_ENABLE_PASS:
    PASS = 0;
    DPC_RESULT[63..0] = $0000000000000000;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $da;
    DRSCAN 64, $0000000004024840;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 64, $0000000000000000, CAPTURE DPC_RESULT[];
        IF ( ! (DPC_RESULT[63]==0) ) THEN GOTO DPC2_POLL;
        IPOLL = 0;
        PASS = 1;
        DPC2_POLL:
        IF ( ! (PASS==0) ) THEN GOTO DPC2_DONE;
        IRSCAN 8, $da;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        DPC2_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE PRINT_IDCODE USES GV;
    EXPORT "IDCODE", ID[];
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE VERIFY_IDCODE USES GV,PARAMETERS,DO_EXIT;
    FREQUENCY (FREQ*1000000);
    WAIT RESET, 5 CYCLES;
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $0f;
    DRSCAN 32, $00000000;
    WAIT IDLE, 1 CYCLES;
    DRSCAN 32, $00000000, CAPTURE ID[],COMPARE IDCODEVALUE[],IDMASK[],PASS;
    IF ( ! (PASS==0) ) THEN GOTO IDOK;
    STATUS = 6;
    UNIQUEEXITCODE = 32772;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    PRINT "Failed to verify IDCODE";
    CALL DO_EXIT;
    IDOK:
    IDREV = INT(ID[31..28]);
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE GET_DATA_STATUS USES GV;
    INTEGER IPOLLDATA =0;
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $c9;
    DRSCAN 32, $00000000;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLLDATA = 27777 TO 0 STEP -1;
        DRSCAN 32, $00000000, CAPTURE DATA_STATUS_RESULT[31..0];
        IF ( ! (DATA_STATUS_RESULT[31]==0) ) THEN GOTO DATA_STATUS_POLL;
        IPOLLDATA = 0;
        PASS = 1;
        DATA_STATUS_POLL:
        IF ( ! (PASS==0) ) THEN GOTO DATA_STATUS_READ;
        IRSCAN 8, $c9;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        DATA_STATUS_READ:
        LABEL_SEPARATOR = 0;
    NEXT IPOLLDATA;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE READ_CERTIFICATE USES GV,READ_SHARED_BUFFER;
    IBLOCKS = (CERTIFICATE_SIZE/128);
    IF ( ! ((CERTIFICATE_SIZE%128)!=0) ) THEN GOTO NO_INCOM_BLOCK;
    IBLOCKS = (IBLOCKS+1);
    NO_INCOM_BLOCK:
    CALL READ_SHARED_BUFFER;
    COMPONENTDIGEST[255..0] = SHARED_BUFFER[399..144];
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE PROCESS_DATA USES BITSTREAM,GV,CONSTBLOCK,DO_EXIT,GET_DATA_STATUS,READ_CERTIFICATE;
    BOOLEAN DATA_SHIFT_RESULT[128];
    INTEGER BLOCKNO =0;
    INTEGER CURRNUMOFBLOCKS =0;
    INTEGER COMPONENTNO =0;
    INTEGER TOTALNUMOFBLOCKS =0;
    INTEGER TOTALCURRBLOCK =0;
    IF ( ! (ACTIONTYPE!=ACTION_ERA) ) THEN GOTO DONT_UPDATE_BAR;
    FOR COMPONENTNO = (ICURCOMPONENTNO+1) TO ICURNUMOFCOMPONENTS STEP 1;
        CURRNUMOFBLOCKS = INT(NUMOFBLOCKS[((COMPONENTNO*22)-1)..((COMPONENTNO-1)*22)]);
        TOTALNUMOFBLOCKS = (TOTALNUMOFBLOCKS+CURRNUMOFBLOCKS);
    NEXT COMPONENTNO;
    DONT_UPDATE_BAR:
    FOR COMPONENTNO = ICURCOMPONENTNO TO ICURNUMOFCOMPONENTS STEP 1;
        IRSCAN 8, $ee;
        DRSCAN 128, DATASTREAM[(DATAINDEX+127)..DATAINDEX];
        COMPONENETSUPPORTSCERT = 0;
        CURRNUMOFBLOCKS = INT(NUMOFBLOCKS[((COMPONENTNO*22)-1)..((COMPONENTNO-1)*22)]);
        FOR BLOCKNO = 1 TO CURRNUMOFBLOCKS STEP 1;
            IF ( ! (COMPONENTNO!=ICURCOMPONENTNO) ) THEN GOTO FIRST_COMP;
            TOTALCURRBLOCK = (TOTALCURRBLOCK+1);
            FIRST_COMP:
            IF ( ! (BLOCKNO==1) ) THEN GOTO NOT_FIRST_BLOCK1;
            COMPONENETSUPPORTSCERT = INT(DATASTREAM[(DATAINDEX+2721)..(DATAINDEX+2721)]);
            COMPTYPE = INT(DATASTREAM[(DATAINDEX+391)..(DATAINDEX+384)]);
            NOT_FIRST_BLOCK1:
            PASS = 0;
            WAIT 45 USEC, DRPAUSE;
            FOR IPOLL = 510000 TO 0 STEP -1;
                IF ( ! (IPOLL==510000) ) THEN GOTO NOT_FIRST_POLL;
                IF ( ! (COMPTYPE==0) ) THEN GOTO NOT_COMP_0;
                IF ( ! (SEC_UCNFG[12]==1) ) THEN GOTO RECOVERY_ENABLED;
                IPOLL = 250000;
                RECOVERY_ENABLED:
                LABEL_SEPARATOR = 0;
                NOT_COMP_0:
                IF ( ! (COMPTYPE!=0) ) THEN GOTO COMP_0;
                IPOLL = 83333;
                COMP_0:
                LABEL_SEPARATOR = 0;
                NOT_FIRST_POLL:
                IF ( ! ( (COMPONENTNO!=ICURNUMOFCOMPONENTS)||(BLOCKNO!=CURRNUMOFBLOCKS)) ) THEN GOTO LAST_BLOCK;
                DRSCAN 128, DATASTREAM[(DATAINDEX+255)..(DATAINDEX+128)], CAPTURE DATA_SHIFT_RESULT[127..0];
                LAST_BLOCK:
                IF ( ! ( (COMPONENTNO==ICURNUMOFCOMPONENTS)&&(BLOCKNO==CURRNUMOFBLOCKS)) ) THEN GOTO NOT_LAST_BLOCK;
                DRSCAN 128, DATASTREAM[(DATAINDEX+127)..DATAINDEX], CAPTURE DATA_SHIFT_RESULT[127..0];
                NOT_LAST_BLOCK:
                IF ( ! (DATA_SHIFT_RESULT[127]==0) ) THEN GOTO DATA_POLL;
                IPOLL = 0;
                PASS = 1;
                DATA_POLL:
                IF ( ! (PASS==0) ) THEN GOTO DATA_DONE;
                IRSCAN 8, $ee;
                WAIT IRPAUSE, 10 USEC, IRPAUSE;
                DATA_DONE:
                LABEL_SEPARATOR = 0;
            NEXT IPOLL;
            IF ( ! ( (PASS==0)||( (PASS==1)&&( (DATA_SHIFT_RESULT[3]==1)||(DATA_SHIFT_RESULT[4]==1)))) ) THEN GOTO DATA_PASS;
            IF ( ! (PASS==0) ) THEN GOTO POLL_COMPLETED;
            PRINT "Instruction timed out.";
            PRINT "componentNo: ",COMPONENTNO;
            PRINT "blockNo: ",BLOCKNO;
            STATUS = -32;
            IF ( ! (ACTIONTYPE==ACTION_PROG) ) THEN GOTO NOT_PROG_ACTION;
            UNIQUEEXITCODE = 32824;
            EXPORT "ERROR_CODE", BUFF32[15..0];
            NOT_PROG_ACTION:
            IF ( ! (ACTIONTYPE==ACTION_VER) ) THEN GOTO NOT_VERIFY_ACTION;
            UNIQUEEXITCODE = 32822;
            EXPORT "ERROR_CODE", BUFF32[15..0];
            NOT_VERIFY_ACTION:
            IF ( ! (ACTIONTYPE==ACTION_ERA) ) THEN GOTO NOT_ERASE_ACTION;
            UNIQUEEXITCODE = 32820;
            EXPORT "ERROR_CODE", BUFF32[15..0];
            NOT_ERASE_ACTION:
            IF ( ! (ACTIONTYPE==ACTION_AUTH) ) THEN GOTO NOT_AUTH_ACTION;
            UNIQUEEXITCODE = 32818;
            EXPORT "ERROR_CODE", BUFF32[15..0];
            NOT_AUTH_ACTION:
            CALL DO_EXIT;
            POLL_COMPLETED:
            CALL GET_DATA_STATUS;
            IF ( ! ( (PASS==0)||( (PASS==1)&&(DATA_STATUS_RESULT[2]==1))) ) THEN GOTO NO_ERROR_PER_BLOCK;
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])!=0) ) THEN GOTO NOT_AUTHERR;
            PRINT "Authentication Error.";
            IF ( ! ( ( ( (INT(DATA_STATUS_RESULT[15..8])==1)||(INT(DATA_STATUS_RESULT[15..8])==2))||(INT(DATA_STATUS_RESULT[15..8])==4))||(INT(DATA_STATUS_RESULT[15..8])==8)) ) THEN GOTO NOT_INVALID_BITSTREAM;
            PRINT "Bitstream or data is corrupted or noisy.";
            STATUS = -22;
            UNIQUEEXITCODE = 32799;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            NOT_INVALID_BITSTREAM:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==3) ) THEN GOTO ENC_KEY_SATISFIED;
            PRINT "Invalid/Corrupted encryption key.";
            STATUS = -23;
            UNIQUEEXITCODE = 32801;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            ENC_KEY_SATISFIED:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==5) ) THEN GOTO BACKLEVEL_SATISFIED;
            PRINT "Back level not satisfied.";
            STATUS = -24;
            UNIQUEEXITCODE = 32803;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            BACKLEVEL_SATISFIED:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==7) ) THEN GOTO DSN_SATISFIED;
            PRINT "DSN binding mismatch";
            STATUS = -25;
            UNIQUEEXITCODE = 32805;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            DSN_SATISFIED:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==9) ) THEN GOTO DEVCAP_SATISFIED;
            PRINT "Bitstream and device mismatch";
            STATUS = -26;
            UNIQUEEXITCODE = 32807;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            DEVCAP_SATISFIED:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==10) ) THEN GOTO CORRECT_IDCODE;
            PRINT "Incorrect DEVICEID.";
            STATUS = -27;
            UNIQUEEXITCODE = 32809;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            CORRECT_IDCODE:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==11) ) THEN GOTO BITSTREAM_FINE;
            PRINT "Programming file is out of date, please regenerate.";
            STATUS = -28;
            UNIQUEEXITCODE = 32811;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            BITSTREAM_FINE:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==12) ) THEN GOTO BITSTREAM_VER;
            PRINT "Programming file does not support verification.";
            STATUS = -29;
            UNIQUEEXITCODE = 32813;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            BITSTREAM_VER:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==13) ) THEN GOTO DEVCAP_ACCESS;
            PRINT "Invalid or inaccessible Device Certificate.";
            STATUS = -31;
            UNIQUEEXITCODE = 32816;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            DEVCAP_ACCESS:
            LABEL_SEPARATOR = 0;
            NOT_AUTHERR:
            IF ( ! (INT(DATA_STATUS_RESULT[7..3])!=0) ) THEN GOTO NOT_ERRORCODE;
            IF ( ! (INT(DATA_STATUS_RESULT[7..3])==5) ) THEN GOTO NOT_NVMVERIFY;
            IF ( ! (PREPARING_BITSTREAM==0) ) THEN GOTO SKIP_VERIFYNVM_DISP;
            PRINT "Failed to verify eNVM.";
            STATUS = 11;
            UNIQUEEXITCODE = 32776;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            SKIP_VERIFYNVM_DISP:
            LABEL_SEPARATOR = 0;
            NOT_NVMVERIFY:
            IF ( ! (INT(DATA_STATUS_RESULT[7..3])==4) ) THEN GOTO NOT_NVMPRG;
            PRINT "Failed to program eNVM.";
            STATUS = 10;
            UNIQUEEXITCODE = 32773;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            NOT_NVMPRG:
            IF ( ! (INT(DATA_STATUS_RESULT[7..3])==2) ) THEN GOTO DEVICE_NO_SEC;
            PRINT "Device security prevented operation.";
            STATUS = -21;
            UNIQUEEXITCODE = 32797;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            DEVICE_NO_SEC:
            IF ( ! (INT(DATA_STATUS_RESULT[7..3])==1) ) THEN GOTO FABRIC_VER_FINE;
            IF ( ! (PREPARING_BITSTREAM==0) ) THEN GOTO SKIP_VERIFY_DISP;
            IF ( ! (INT(DATA_STATUS_RESULT[23..16])==248) ) THEN GOTO NOT_FC;
            PRINT "Failed to verify Fabric Configuration.";
            NOT_FC:
            IF ( ! ( ( (INT(DATA_STATUS_RESULT[23..16])==249)||(INT(DATA_STATUS_RESULT[23..16])==250))||(INT(DATA_STATUS_RESULT[23..16])==251)) ) THEN GOTO NOT_SEC;
            PRINT "Failed to verify Security.";
            NOT_SEC:
            IF ( ! ( ( ( (INT(DATA_STATUS_RESULT[23..16])!=248)&&(INT(DATA_STATUS_RESULT[23..16])!=249))&&(INT(DATA_STATUS_RESULT[23..16])!=250))&&(INT(DATA_STATUS_RESULT[23..16])!=251)) ) THEN GOTO NOT_FABRIC;
            PRINT "Failed to verify FPGA Array.";
            NOT_FABRIC:
            STATUS = 11;
            UNIQUEEXITCODE = 32775;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            SKIP_VERIFY_DISP:
            LABEL_SEPARATOR = 0;
            FABRIC_VER_FINE:
            LABEL_SEPARATOR = 0;
            NOT_ERRORCODE:
            IF ( ! ( (PREPARING_BITSTREAM==0)||(INT(DATA_STATUS_RESULT[15..8])!=0)) ) THEN GOTO SKIP_VERIFY_EXIT;
            IF ( ! (COMPTYPE==0) ) THEN GOTO NOT_BITS_COMP;
            PRINT "Component: BITS";
            NOT_BITS_COMP:
            IF ( ! (COMPTYPE==1) ) THEN GOTO NOT_FPGA_COMP;
            PRINT "Component: FPGA";
            NOT_FPGA_COMP:
            IF ( ! (COMPTYPE==2) ) THEN GOTO NOT_SEC_COMP;
            PRINT "Component: Security";
            NOT_SEC_COMP:
            IF ( ! (COMPTYPE==3) ) THEN GOTO NOT_ENVM_COMP;
            PRINT "Component: eNVM";
            NOT_ENVM_COMP:
            IF ( ! (COMPTYPE==127) ) THEN GOTO NOT_EOB_COMP;
            PRINT "Component: EOB";
            NOT_EOB_COMP:
            PRINT "componentNo: ",COMPONENTNO;
            PRINT "blockNo: ",BLOCKNO;
            EXPORT "DATA_STATUS_RESULT: ", DATA_STATUS_RESULT[31..0];
            CALL DO_EXIT;
            SKIP_VERIFY_EXIT:
            LABEL_SEPARATOR = 0;
            NO_ERROR_PER_BLOCK:
            LABEL_SEPARATOR = 0;
            DATA_PASS:
            IF ( ! ( (COMPONENTNO!=ICURCOMPONENTNO)&&((TOTALCURRBLOCK%1500)==0)) ) THEN GOTO DONT_UPDATE_PERCENTAGE;
            PERCENT_UPDATE = ((100*TOTALCURRBLOCK)/TOTALNUMOFBLOCKS);
            EXPORT "PERCENT_DONE", PERCENT_UPDATE;
            DONT_UPDATE_PERCENTAGE:
            DATAINDEX = (DATAINDEX+128);
        NEXT BLOCKNO;
        IF ( ! ( (ACTIONTYPE==ACTION_PROG)&&(COMPONENETSUPPORTSCERT==1)) ) THEN GOTO DONT_DUMP_DIGEST1;
        IF ( ! (COMPTYPE==1) ) THEN GOTO DUMMY2;
        CALL READ_CERTIFICATE;
        EXPORT "Fabric component digest", COMPONENTDIGEST[];
        DUMMY2:
        IF ( ! (COMPTYPE==3) ) THEN GOTO DUMMY4;
        CALL READ_CERTIFICATE;
        EXPORT "eNVM component digest", COMPONENTDIGEST[];
        DUMMY4:
        LABEL_SEPARATOR = 0;
        DONT_DUMP_DIGEST1:
        LABEL_SEPARATOR = 0;
    NEXT COMPONENTNO;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SET_MODE USES GV,DO_EXIT,LOAD_AUXLO;
    IF ( ! (COFC_FORMAT==1) ) THEN GOTO OLD_COFC2;
    AUXLO_REG[127..0] = COFC_NONCE[127..0];
    CALL LOAD_AUXLO;
    OLD_COFC2:
    BOOLEAN DATA_INIT_RESULT[8];
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $ae;
    DRSCAN 8, PGMMODE[];
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 8, $00, CAPTURE DATA_INIT_RESULT[7..0];
        IF ( ! (DATA_INIT_RESULT[7]==0) ) THEN GOTO DATA_INIT_POLL;
        IPOLL = 0;
        PASS = 1;
        DATA_INIT_POLL:
        IF ( ! (PASS==0) ) THEN GOTO DATA_INIT_DONE;
        IRSCAN 8, $ae;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        DATA_INIT_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO DATA_INIT_PASSED;
    PRINT "Failed to set programming mode";
    STATUS = 5;
    CALL DO_EXIT;
    DATA_INIT_PASSED:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_ERASE USES GV,PROCESS_DATA,SET_MODE;
    PRINT "Erasing FPGA Array...";
    PGMMODE[7..0] = $01;
    CALL SET_MODE;
    DATAINDEX = DATAERASESTARTINDEX;
    ICURCOMPONENTNO = (NUMOFCOMPONENTS-(DATAERASESIZE-1));
    ICURNUMOFCOMPONENTS = NUMOFCOMPONENTS;
    CALL PROCESS_DATA;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_PREPARE_BITSTREAM USES GV,CONSTBLOCK,PROCESS_DATA,SET_MODE;
    PREPARING_BITSTREAM = 1;
    PGMMODE[7..0] = $02;
    CALL SET_MODE;
    INTEGER ORIGACTIONTYPE =ACTIONTYPE;
    ACTIONTYPE = ACTION_VER;
    ICURCOMPONENTNO = 1;
    ICURNUMOFCOMPONENTS = 2;
    DATAINDEX = DATASTARTINDEX;
    INTEGER PREV_NUM_OF_BLOCKS =INT(NUMOFBLOCKS[43..22]);
    BUFF32[31..0] = BOOL(91);
    NUMOFBLOCKS[43..22] = BUFF32[21..0];
    CALL PROCESS_DATA;
    NUMOFBLOCKS[43..22] = BOOL(PREV_NUM_OF_BLOCKS);
    PREPARING_BITSTREAM = 0;
    ACTIONTYPE = ORIGACTIONTYPE;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_VERIFY USES GV,PROCESS_DATA,SET_MODE;
    IF ( ! (RANPROGRAMMINGACTION==1) ) THEN GOTO RAN_PROGRAM;
    RANPROGRAMMINGACTION = 0;
    RAN_PROGRAM:
    PRINT "Verifying FPGA Array...";
    PGMMODE[7..0] = $02;
    CALL SET_MODE;
    ICURCOMPONENTNO = 1;
    ICURNUMOFCOMPONENTS = DATASIZE;
    DATAINDEX = DATASTARTINDEX;
    CALL PROCESS_DATA;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_PROGRAM USES GV,PROCESS_DATA,SET_MODE;
    PRINT "Programming FPGA Array...";
    PGMMODE[7..0] = $01;
    CALL SET_MODE;
    ICURCOMPONENTNO = 1;
    ICURNUMOFCOMPONENTS = DATASIZE;
    DATAINDEX = DATASTARTINDEX;
    CALL PROCESS_DATA;
    RANPROGRAMMINGACTION = 1;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_AUTHENTICATION USES GV,PROCESS_DATA,SET_MODE;
    PRINT "Encrypted data authentication...";
    PGMMODE[7..0] = $00;
    CALL SET_MODE;
    ICURCOMPONENTNO = 1;
    ICURNUMOFCOMPONENTS = DATASIZE;
    DATAINDEX = DATASTARTINDEX;
    CALL PROCESS_DATA;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DUMP_PROG_INFO USES GV,CONSTBLOCK;
    INTEGER TMPINT =0;
    BUFF32[31..0] = READ_PROG_INFO_RESULT[95..64];
    IF ( ! (INT(READ_PROG_INFO_RESULT[15..0])!=65535) ) THEN GOTO UNKNOWN_CYCLE_COUNT;
    PRINT "CYCLE COUNT: ",INT(READ_PROG_INFO_RESULT[15..0]);
    UNKNOWN_CYCLE_COUNT:
    IF ( ! (INT(READ_PROG_INFO_RESULT[15..0])==65535) ) THEN GOTO KNOWN_CYCLE_COUNT;
    PRINT "CYCLE COUNT: Not available";
    KNOWN_CYCLE_COUNT:
    EXPORT "PROG_INFO", READ_PROG_INFO_RESULT[127..0];
    TMPINT = INT(READ_PROG_INFO_RESULT[48..48]);
    IF ( ! (TMPINT==0) ) THEN GOTO NOT_12;
    PRINT "VCC was programmed at 1.2V";
    NOT_12:
    IF ( ! (TMPINT==1) ) THEN GOTO NOT_10;
    PRINT "VCC was programmed at 1.0V";
    NOT_10:
    PRINT "Warning: Algorithm Version, Programmer, Software Version, Programming Software
        , Programming Interface Protocol, and Programming File Type information do not get programmed with Auto Programming
        , Auto Update (IAP), Programming Recovery, or IAP/ISP Services and should be ignored.";
    TMPINT = INT(BUFF32[5..0]);
    IF ( ! ( (TMPINT==0)||(TMPINT==63)) ) THEN GOTO NOT_UNDEF;
    PRINT "Algorithm Version:";
    NOT_UNDEF:
    IF ( ! ( (TMPINT!=0)&&(TMPINT!=63)) ) THEN GOTO UNDEF;
    PRINT "Algorithm Version: ",INT(BUFF32[5..0]);
    UNDEF:
    TMPINT = INT(BUFF32[9..6]);
    IF ( ! (TMPINT==SELF) ) THEN GOTO NOT_SELF;
    PRINT "Programmer: SPI Master Auto Programming";
    NOT_SELF:
    IF ( ! (TMPINT==SCULPTW) ) THEN GOTO NOT_SCULPTW;
    PRINT "Programmer: Silicon Sculptor II/III";
    NOT_SCULPTW:
    IF ( ! (TMPINT==BPWIN) ) THEN GOTO NOT_BPW;
    PRINT "Programmer: BP Programmer";
    NOT_BPW:
    IF ( ! (TMPINT==MICROSEMI_IHP) ) THEN GOTO NOT_MICROSEMI_IHP;
    PRINT "Programmer: Microsemi IHP";
    NOT_MICROSEMI_IHP:
    IF ( ! (TMPINT==FP3) ) THEN GOTO NOT_FP3;
    PRINT "Programmer: FlashPro3";
    NOT_FP3:
    IF ( ! (TMPINT==FP4) ) THEN GOTO NOT_FP4;
    PRINT "Programmer: FlashPro4";
    NOT_FP4:
    IF ( ! (TMPINT==FP5) ) THEN GOTO NOT_FTDI;
    PRINT "Programmer: FlashPro5";
    NOT_FTDI:
    IF ( ! (TMPINT==SIL_EXPL) ) THEN GOTO NOT_SIL_EXPL;
    PRINT "Programmer: Silicon Explorer";
    NOT_SIL_EXPL:
    IF ( ! (TMPINT==ATE) ) THEN GOTO NOT_ATE;
    PRINT "Programmer: Non Microsemi Programmer";
    NOT_ATE:
    IF ( ! ( (TMPINT==0)||(TMPINT==15)) ) THEN GOTO UNDEF_P_T;
    PRINT "Programmer:";
    UNDEF_P_T:
    TMPINT = INT(BUFF32[22..17]);
    IF ( ! (TMPINT==FP34) ) THEN GOTO NOT_FP34;
    PRINT "Software Version: FlashPro v3.4";
    NOT_FP34:
    IF ( ! (TMPINT==FP40) ) THEN GOTO NOT_FP40;
    PRINT "Software Version: FlashPro v4.0";
    NOT_FP40:
    IF ( ! (TMPINT==FP41) ) THEN GOTO NOT_FP41;
    PRINT "Software Version: FlashPro v4.1";
    NOT_FP41:
    IF ( ! (TMPINT==FP42) ) THEN GOTO NOT_FP42;
    PRINT "Software Version: FlashPro v4.2";
    NOT_FP42:
    IF ( ! (TMPINT==FP50) ) THEN GOTO NOT_FP50;
    PRINT "Software Version: FlashPro v5.0";
    NOT_FP50:
    IF ( ! (TMPINT==FP51) ) THEN GOTO NOT_FP51;
    PRINT "Software Version: FlashPro v5.1";
    NOT_FP51:
    IF ( ! (TMPINT==FP60) ) THEN GOTO NOT_FP60;
    PRINT "Software Version: FlashPro v6.0";
    NOT_FP60:
    IF ( ! (TMPINT==FP61) ) THEN GOTO NOT_FP61;
    PRINT "Software Version: FlashPro v6.1";
    NOT_FP61:
    IF ( ! (TMPINT==FP62) ) THEN GOTO NOT_FP62;
    PRINT "Software Version: FlashPro v6.2";
    NOT_FP62:
    IF ( ! (TMPINT==FP84) ) THEN GOTO NOT_FP84;
    PRINT "Software Version: FlashPro v8.4";
    NOT_FP84:
    IF ( ! (TMPINT==FP85) ) THEN GOTO NOT_FP85;
    PRINT "Software Version: FlashPro v8.5";
    NOT_FP85:
    IF ( ! (TMPINT==FP86) ) THEN GOTO NOT_FP86;
    PRINT "Software Version: FlashPro v8.6";
    NOT_FP86:
    IF ( ! (TMPINT==FP90) ) THEN GOTO NOT_FP90;
    PRINT "Software Version: FlashPro v9.0";
    NOT_FP90:
    IF ( ! (TMPINT==FP91) ) THEN GOTO NOT_FP91;
    PRINT "Software Version: FlashPro v9.1";
    NOT_FP91:
    IF ( ! (TMPINT==FP_10_LCP) ) THEN GOTO NOT_10_LCP;
    PRINT "Software Version: FlashPro 10.0 LCP";
    NOT_10_LCP:
    IF ( ! (TMPINT==FP_11_BETA_SPA) ) THEN GOTO NOT_11_BETA_SPA;
    PRINT "Software Version: FlashPro 11.0 Beta SPA";
    NOT_11_BETA_SPA:
    IF ( ! (TMPINT==FP_11_BETA_SP1) ) THEN GOTO NOT_11_BETA_SP1;
    PRINT "Software Version: FlashPro 11.0 Beta SP1";
    NOT_11_BETA_SP1:
    IF ( ! (TMPINT==FP_11) ) THEN GOTO NOT_11;
    PRINT "Software Version: FlashPro 11.0";
    NOT_11:
    IF ( ! (TMPINT==FP_11_1) ) THEN GOTO NOT_11_1;
    PRINT "Software Version: FlashPro 11.1";
    NOT_11_1:
    IF ( ! (TMPINT==FP_11_2) ) THEN GOTO NOT_11_2;
    PRINT "Software Version: FlashPro 11.2";
    NOT_11_2:
    IF ( ! (TMPINT==FP_11_3) ) THEN GOTO NOT_11_3;
    PRINT "Software Version: FlashPro 11.3";
    NOT_11_3:
    IF ( ! (TMPINT==FP_11_4) ) THEN GOTO NOT_11_4;
    PRINT "Software Version: 11.4";
    NOT_11_4:
    IF ( ! (TMPINT==FP_11_5) ) THEN GOTO NOT_11_5;
    PRINT "Software Version: 11.5";
    NOT_11_5:
    IF ( ! (TMPINT==FP_11_6) ) THEN GOTO NOT_11_6;
    PRINT "Software Version: 11.6";
    NOT_11_6:
    IF ( ! (TMPINT==FP_11_7) ) THEN GOTO NOT_11_7;
    PRINT "Software Version: 11.7";
    NOT_11_7:
    IF ( ! (TMPINT==FP_11_8) ) THEN GOTO NOT_11_8;
    PRINT "Software Version: 11.8";
    NOT_11_8:
    IF ( ! ( (TMPINT==0)||(TMPINT==63)) ) THEN GOTO NOT_UNDEF_SOFT_VER;
    PRINT "Software Version:";
    NOT_UNDEF_SOFT_VER:
    TMPINT = INT(BUFF32[25..23]);
    IF ( ! (TMPINT==FP) ) THEN GOTO NOT_FP;
    PRINT "Programming Software: FlashPro";
    NOT_FP:
    IF ( ! (TMPINT==DIRECTC) ) THEN GOTO NOT_DC;
    PRINT "Programming Software: Direct C";
    NOT_DC:
    IF ( ! (TMPINT==FPX) ) THEN GOTO NOT_FPX;
    PRINT "Programming Software: FlashPro Express";
    NOT_FPX:
    IF ( ! (TMPINT==NON_MICROSEMI) ) THEN GOTO NOT_NON_MICROSEMI;
    PRINT "Programming Software: Non Microsemi SW";
    NOT_NON_MICROSEMI:
    IF ( ! ( (TMPINT==0)||(TMPINT==7)) ) THEN GOTO UNDEF_P_S;
    PRINT "Programming Software:";
    UNDEF_P_S:
    TMPINT = INT(BUFF32[28..26]);
    IF ( ! (TMPINT==SPI_MASTER) ) THEN GOTO NOT_SPI_MASTER;
    PRINT "Programming Interface Protocol: SPI Master";
    NOT_SPI_MASTER:
    IF ( ! (TMPINT==SPI_SLAVE) ) THEN GOTO NOT_SPI_SLAVE;
    PRINT "Programming Interface Protocol: SPI Slave";
    NOT_SPI_SLAVE:
    IF ( ! (TMPINT==JTAG) ) THEN GOTO NOT_JTAG;
    PRINT "Programming Interface Protocol: JTAG";
    NOT_JTAG:
    IF ( ! ( (TMPINT==0)||(TMPINT>3)) ) THEN GOTO UNDEF_P_I_P;
    PRINT "Programming Interface Protocol:";
    UNDEF_P_I_P:
    TMPINT = INT(BUFF32[31..29]);
    IF ( ! (TMPINT==PDB) ) THEN GOTO NOT_PDB;
    PRINT "Programming File Type: PDB";
    NOT_PDB:
    IF ( ! (TMPINT==STAPL) ) THEN GOTO NOT_STAPL;
    PRINT "Programming File Type: STAPL";
    NOT_STAPL:
    IF ( ! (TMPINT==SVF) ) THEN GOTO NOT_SVF;
    PRINT "Programming File Type: SVF";
    NOT_SVF:
    IF ( ! (TMPINT==PCF) ) THEN GOTO NOT_PCF;
    PRINT "Programming File Type: PCF";
    NOT_PCF:
    IF ( ! (TMPINT==IEEE1532) ) THEN GOTO NOT_IEEE1532;
    PRINT "Programming File Type: IEEE 1532";
    NOT_IEEE1532:
    IF ( ! ( (TMPINT==0)||(TMPINT==7)) ) THEN GOTO UNDEF_P_F_T;
    PRINT "Programming File Type:";
    UNDEF_P_F_T:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE FIX_INT_ARRAYS USES GV;
    INTEGER TEMP =0;
    IF ( ! (HEX[0]!=48) ) THEN GOTO NOT_48;
    FOR I = 0 TO 7;
        TEMP = HEX[I];
        HEX[I] = HEX[(15-I)];
        HEX[(15-I)] = TEMP;
    NEXT I;
    NOT_48:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_READ_DESIGN_INFO USES GV,DO_EXIT,READ_SHARED_BUFFER;
    BOOLEAN READ_DESIGN_INFO_RESULT[8];
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $a6;
    DRSCAN 8, $00;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 8, $00, CAPTURE READ_DESIGN_INFO_RESULT[];
        IF ( ! (READ_DESIGN_INFO_RESULT[7]==0) ) THEN GOTO READ_DESIGN_INFO_POLL;
        IPOLL = 0;
        PASS = 1;
        READ_DESIGN_INFO_POLL:
        IF ( ! (PASS==0) ) THEN GOTO READ_DESIGN_INFO_DONE;
        IRSCAN 8, $a6;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        READ_DESIGN_INFO_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO READ_DESIGN_INFO_PASS;
    PRINT "Failed to read design information.";
    STATUS = 5;
    CALL DO_EXIT;
    READ_DESIGN_INFO_PASS:
    IBLOCKS = 3;
    CALL READ_SHARED_BUFFER;
    PRINT "Design Name: ",CHR$(INT(SHARED_BUFFER[23..16])),CHR$(INT(SHARED_BUFFER[31..24]))
        ,CHR$(INT(SHARED_BUFFER[39..32])),CHR$(INT(SHARED_BUFFER[47..40])),CHR$(INT(SHARED_BUFFER[55..48]))
        ,CHR$(INT(SHARED_BUFFER[63..56])),CHR$(INT(SHARED_BUFFER[71..64])),CHR$(INT(SHARED_BUFFER[79..72]))
        ,CHR$(INT(SHARED_BUFFER[87..80])),CHR$(INT(SHARED_BUFFER[95..88])),CHR$(INT(SHARED_BUFFER[103..96]))
        ,CHR$(INT(SHARED_BUFFER[111..104])),CHR$(INT(SHARED_BUFFER[119..112])),CHR$(INT(SHARED_BUFFER[127..120]))
        ,CHR$(INT(SHARED_BUFFER[135..128])),CHR$(INT(SHARED_BUFFER[143..136])),CHR$(INT(SHARED_BUFFER[151..144]))
        ,CHR$(INT(SHARED_BUFFER[159..152])),CHR$(INT(SHARED_BUFFER[167..160])),CHR$(INT(SHARED_BUFFER[175..168]))
        ,CHR$(INT(SHARED_BUFFER[183..176])),CHR$(INT(SHARED_BUFFER[191..184])),CHR$(INT(SHARED_BUFFER[199..192]))
        ,CHR$(INT(SHARED_BUFFER[207..200])),CHR$(INT(SHARED_BUFFER[215..208])),CHR$(INT(SHARED_BUFFER[223..216]))
        ,CHR$(INT(SHARED_BUFFER[231..224])),CHR$(INT(SHARED_BUFFER[239..232])),CHR$(INT(SHARED_BUFFER[247..240]))
        ,CHR$(INT(SHARED_BUFFER[255..248]));
    EXPORT "CHECKSUM", SHARED_BUFFER[15..0];
    EXPORT "READ_DESIGN_INFO: ", SHARED_BUFFER[271..0];
    EXPORT "DESIGNVER", SHARED_BUFFER[271..256];
    EXPORT "BACKLEVEL", SHARED_BUFFER[287..272];
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_READ_PROG_INFO USES GV,DO_EXIT;
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $e7;
    DRSCAN 128, $00000000000000000000000000000000;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 128, $00000000000000000000000000000000, CAPTURE READ_PROG_INFO_RESULT[];
        IF ( ! (READ_PROG_INFO_RESULT[127]==0) ) THEN GOTO READ_PROG_INFO_POLL;
        IPOLL = 0;
        PASS = 1;
        READ_PROG_INFO_POLL:
        IF ( ! (PASS==0) ) THEN GOTO READ_PROG_INFO_DONE;
        IRSCAN 8, $e7;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        READ_PROG_INFO_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO READ_PROG_INFO_PASS;
    PRINT "Failed to read programming information.";
    STATUS = 5;
    CALL DO_EXIT;
    READ_PROG_INFO_PASS:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_VERIFY_ZEROIZATION_DIGEST USES GV,CONSTBLOCK,SHA256,SHA256_INIT,SHA256_UPDATE
    ,SHA256_FINAL,DO_EXIT,READ_SHARED_BUFFER;
    BOOLEAN FETCH_ZERO_INPUT[129] = $fffffffffffffffffffffffffffffffff;
    BOOLEAN FETCH_ZERO_OUTPUT[129];
    BOOLEAN FETCH_ZERO_MATCH;
    BOOLEAN FETCH_ZERO_FSN[64];
    BOOLEAN FETCH_ZERO_DIGEST[256];
    BOOLEAN FETCH_ZERO_VALIDATOR[32];
    BOOLEAN FETCH_ZERO_FABRICRAMZEROIZED;
    INTEGER FETCH_ZERO_I;
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $f5;
    DRSCAN 129, FETCH_ZERO_INPUT[128..0];
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 1000000 TO 0 STEP -1;
        DRSCAN 129, $fffffffffffffffffffffffffffffffff, CAPTURE FETCH_ZERO_OUTPUT[128..0];
        IF ( ! (FETCH_ZERO_OUTPUT[128]==0) ) THEN GOTO FETCH_ZERO_POLL;
        IPOLL = 0;
        PASS = 1;
        FETCH_ZERO_POLL:
        IF ( ! (PASS==0) ) THEN GOTO FETCH_ZERO_DONE;
        IRSCAN 8, $f5;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        FETCH_ZERO_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO FETCH_ZERO_PASS1;
    PRINT "Failed to fetch zeroization result.";
    STATUS = -19;
    CALL DO_EXIT;
    FETCH_ZERO_PASS1:
    IF ( ! (FETCH_ZERO_OUTPUT[0]==0) ) THEN GOTO FETCH_ZERO_DETECTED;
    PRINT "--- Previous zeroization results detected --- ";
    IBLOCKS = 5;
    CALL READ_SHARED_BUFFER;
    FETCH_ZERO_FSN[] = SHARED_BUFFER[63..0];
    FETCH_ZERO_DIGEST[] = SHARED_BUFFER[319..64];
    FETCH_ZERO_VALIDATOR[] = SHARED_BUFFER[72..41];
    FETCH_ZERO_FABRICRAMZEROIZED = FETCH_ZERO_OUTPUT[1];
    CALL SHA256_INIT;
    SHA256_UPDATE_DATA[447..192] = ZERO_10[255..0];
    SHA256_UPDATE_DATA[191..128] = FETCH_ZERO_FSN[63..0];
    SHA256_UPDATE_DATA[127..0] = $fffffffffffffffffffffffffffffffff;
    SHA256_UPDATE_DATA_SIZE = 448;
    CALL SHA256_UPDATE;
    CALL SHA256_FINAL;
    FETCH_ZERO_MATCH = 1;
    FOR FETCH_ZERO_I = 0 TO 255 STEP 1;
        IF ( ! (SHA256_HASH[FETCH_ZERO_I]!=FETCH_ZERO_DIGEST[FETCH_ZERO_I]) ) THEN GOTO FETCH_ZERO_CMPDG1;
        FETCH_ZERO_MATCH = 0;
        FETCH_ZERO_I = 255;
        FETCH_ZERO_CMPDG1:
        LABEL_SEPARATOR = 0;
    NEXT FETCH_ZERO_I;
    IF ( ! (FETCH_ZERO_MATCH==1) ) THEN GOTO FETCH_ZERO_MOD10;
    PRINT "Detected zeroization mode = 10 'like new'";
    FETCH_ZERO_MOD10:
    IF ( ! (FETCH_ZERO_MATCH==0) ) THEN GOTO FETCH_ZERO_MD0001;
    CALL SHA256_INIT;
    SHA256_UPDATE_DATA[447..192] = ZERO_00_01[255..0];
    SHA256_UPDATE_DATA[191..128] = FETCH_ZERO_FSN[63..0];
    SHA256_UPDATE_DATA[127..0] = $fffffffffffffffffffffffffffffffff;
    SHA256_UPDATE_DATA_SIZE = 448;
    CALL SHA256_UPDATE;
    CALL SHA256_FINAL;
    FETCH_ZERO_MATCH = 1;
    FOR FETCH_ZERO_I = 0 TO 255 STEP 1;
        IF ( ! (SHA256_HASH[FETCH_ZERO_I]!=FETCH_ZERO_DIGEST[FETCH_ZERO_I]) ) THEN GOTO FETCH_ZERO_CMPDG2;
        FETCH_ZERO_MATCH = 0;
        FETCH_ZERO_I = 255;
        FETCH_ZERO_CMPDG2:
        LABEL_SEPARATOR = 0;
    NEXT FETCH_ZERO_I;
    IF ( ! (FETCH_ZERO_MATCH==1) ) THEN GOTO FETCH_ZERO_0001MATCH;
    PRINT "Detected zeroization mode = 01 'recoverable' or 00 'non-recoverable'";
    FETCH_ZERO_0001MATCH:
    LABEL_SEPARATOR = 0;
    FETCH_ZERO_MD0001:
    IF ( ! (FETCH_ZERO_MATCH==1) ) THEN GOTO FETCH_ZERO_VEROK;
    PRINT "Zeroization digest has been verified";
    FETCH_ZERO_VEROK:
    IF ( ! (FETCH_ZERO_MATCH==0) ) THEN GOTO FETCH_ZERO_VERERR;
    PRINT "***Zeroization digest failed verification";
    FETCH_ZERO_VERERR:
    EXPORT "Zeroization data", SHARED_BUFFER[319..0];
    PRINT "---------------------------------------------";
    FETCH_ZERO_DETECTED:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_VERIFY_DIGEST USES GV,DO_EXIT;
    BOOLEAN CHECK_DIGESTS_RESULT[16];
    BOOLEAN CHECK_DIGESTS_INPUT[16];
    PASS = 0;
    INTEGER DIGEST_ERROR =0;
    CHECK_DIGESTS_INPUT[0] = 1;
    CHECK_DIGESTS_INPUT[13..10] = BOOL(15);
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $bc;
    DRSCAN 16, CHECK_DIGESTS_INPUT[15..0];
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 1000000 TO 0 STEP -1;
        DRSCAN 16, $0000, CAPTURE CHECK_DIGESTS_RESULT[15..0];
        IF ( ! (CHECK_DIGESTS_RESULT[15]==0) ) THEN GOTO CHECK_DIGESTS_POLL;
        IPOLL = 0;
        PASS = 1;
        CHECK_DIGESTS_POLL:
        IF ( ! (PASS==0) ) THEN GOTO CHECK_DIGESTS_DONE;
        IRSCAN 8, $bc;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        CHECK_DIGESTS_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO CHECK_DIGESTS_PASS1;
    PRINT "Failed to verify digest.";
    STATUS = -19;
    CALL DO_EXIT;
    CHECK_DIGESTS_PASS1:
    IF ( ! (INT(CHECK_DIGESTS_INPUT[13..10])==INT(CHECK_DIGESTS_RESULT[13..10])) ) THEN GOTO UL_EXTDIGEST_NOT_ENABLED;
    PRINT "Digest request from SPI/JTAG is protected by user pass key 1.";
    STATUS = -18;
    UNIQUEEXITCODE = 32787;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    UL_EXTDIGEST_NOT_ENABLED:
    IF ( ! ( (PASS==1)&&(CHECK_DIGESTS_RESULT[14]==1)) ) THEN GOTO CHECK_DIGESTS_PASS3;
    PRINT "Failed to verify digest.";
    STATUS = -19;
    UNIQUEEXITCODE = 32788;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    CHECK_DIGESTS_PASS3:
    IF ( ! (CHECK_DIGESTS_RESULT[0]==1) ) THEN GOTO FABRIC_DIGEST_FAIL;
    PRINT "FPGA Fabric digest verification: PASS";
    FABRIC_DIGEST_FAIL:
    IF ( ! (CHECK_DIGESTS_RESULT[0]==0) ) THEN GOTO FABRIC_DIGEST_PASS;
    PRINT "FPGA Fabric digest verification: FAIL";
    UNIQUEEXITCODE = 32789;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    DIGEST_ERROR = 1;
    FABRIC_DIGEST_PASS:
    IF ( ! (CHECK_DIGESTS_RESULT[6]==0) ) THEN GOTO FACTORY_PASS;
    PRINT "Factory row and factory key segment digest verification: FAIL";
    UNIQUEEXITCODE = 32795;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    DIGEST_ERROR = 1;
    FACTORY_PASS:
    IF ( ! (CHECK_DIGESTS_RESULT[7]==1) ) THEN GOTO FABRIC_CONFIG_FAIL;
    PRINT "Fabric configuration segment digest verification: PASS";
    FABRIC_CONFIG_FAIL:
    IF ( ! (CHECK_DIGESTS_RESULT[7]==0) ) THEN GOTO FABRIC_CONFIG_PASS;
    PRINT "Fabric configuration segment digest verification: FAIL";
    UNIQUEEXITCODE = 32796;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    DIGEST_ERROR = 1;
    FABRIC_CONFIG_PASS:
    IF ( ! (DIGEST_ERROR==1) ) THEN GOTO ALL_DIGEST_PASSED;
    STATUS = -20;
    ALL_DIGEST_PASSED:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_DEVICE_INFO USES GV,READ_FSN,DO_EXIT,DUMP_SECURITY_INFO,DO_READ_SECURITY
    ,PRINT_IDCODE,DUMP_PROG_INFO,DO_READ_DESIGN_INFO,DO_READ_PROG_INFO,DO_VERIFY_ZEROIZATION_DIGEST;
    CALL PRINT_IDCODE;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $0e;
    WAIT IDLE, 1 CYCLES;
    DRSCAN 32, $00000000, CAPTURE BUFF32[];
    IF ( ! (INT(BUFF32[31..0])==-1) ) THEN GOTO NOT_EMPTY_SILSIG;
    BUFF32[31..0] = $00000000;
    NOT_EMPTY_SILSIG:
    EXPORT "SILSIG", BUFF32[];
    IRSCAN 8, $8f, CAPTURE BUFF32[7..0];
    IF ( ! (BUFF32[2]==1) ) THEN GOTO CORE_NOT_ENABLED;
    PRINT "FPGA Array is programmed and enabled.";
    CORE_NOT_ENABLED:
    IF ( ! (BUFF32[2]==0) ) THEN GOTO CORE_ENABLED;
    PRINT "FPGA Array is not enabled.";
    CORE_ENABLED:
    CALL DO_VERIFY_ZEROIZATION_DIGEST;
    CALL DO_READ_DESIGN_INFO;
    CALL DO_READ_PROG_INFO;
    CALL DUMP_PROG_INFO;
    CALL READ_FSN;
    IF ( ! (READ_FSN_RESULT[128]==1) ) THEN GOTO FSN_NOT_BUSY;
    CALL DO_EXIT;
    FSN_NOT_BUSY:
    CALL DO_READ_SECURITY;
    CALL DUMP_SECURITY_INFO;
    LABEL_SEPARATOR = 0;
ENDPROC;


CRC A20D;
